<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Translations</title>
<style>
  :root {
    color-scheme: light;
    --surface: #fcfcfb; --raised: #ffffff; --text: #0b0b0b; --muted: #52514e; --line: #e1e0d9;
    --complete: #0ca30c; --partial: #fab219; --low: #d03b3b;
    --missing-bg: rgba(208, 59, 59, 0.12); --missing-text: #a12a2a; --focus: #2f6fdd;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      color-scheme: dark;
      --surface: #1a1a19; --raised: #222221; --text: #f0efec; --muted: #c3c2b7; --line: #2c2c2a;
      --missing-bg: rgba(208, 59, 59, 0.26); --missing-text: #ff9b9b; --focus: #7aa7ff;
    }
  }
  * { box-sizing: border-box; }
  body { margin: 0; padding: 24px; background: var(--surface); color: var(--text); font: 14px/1.4 system-ui, sans-serif; }
  h1 { font-size: 20px; margin: 0 0 4px; }
  .sub { color: var(--muted); margin: 0 0 16px; font-variant-numeric: tabular-nums; }
  .tiles { display: grid; grid-template-columns: repeat(auto-fill, minmax(152px, 1fr)); gap: 8px; margin-bottom: 16px; }
  .tile { background: var(--raised); border: 1px solid var(--line); border-top: 4px solid var(--c); border-radius: 6px; padding: 8px 12px; }
  .tile b { display: block; font-size: 22px; font-variant-numeric: tabular-nums; }
  .tile .name { font-weight: 600; }
  .tile small { display: block; color: var(--muted); font-size: 12px; font-variant-numeric: tabular-nums; }
  .meter { height: 6px; border-radius: 3px; background: var(--line); overflow: hidden; margin: 6px 0 4px; }
  .meter i { display: block; height: 100%; background: var(--c); }
  .complete { --c: var(--complete); } .partial { --c: var(--partial); } .low { --c: var(--low); }
  .toolbar { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 16px; margin-bottom: 12px; }
  .toolbar input[type="search"] { flex: 1 1 240px; max-width: 420px; padding: 7px 10px; font: inherit; color: var(--text);
    background: var(--raised); border: 1px solid var(--line); border-radius: 6px; }
  .toolbar label { display: inline-flex; align-items: center; gap: 6px; color: var(--muted); cursor: pointer; user-select: none; }
  .toolbar input[type="checkbox"] { margin: 0; cursor: pointer; }
  input:focus-visible { outline: 2px solid var(--focus); outline-offset: 1px; }
  .count { color: var(--muted); font-size: 12px; margin-left: auto; font-variant-numeric: tabular-nums; }
  .scroll { overflow: auto; max-height: calc(100vh - 48px); border: 1px solid var(--line); border-radius: 6px; background: var(--raised); }
  /* Fixed layout keeps columns still while the filter hides rows. */
  /* Each column gets 160px or more, so narrow screens scroll sideways instead of crushing text. */
  table { border-collapse: collapse; width: 100%; table-layout: fixed; min-width: calc(160px * (var(--locales) + 1)); }
  th, td { padding: 6px 10px; border-top: 1px solid var(--line); text-align: left; vertical-align: top; overflow-wrap: anywhere; }
  thead th { position: sticky; top: 0; z-index: 1; background: var(--raised); border-top: 0; box-shadow: inset 0 -1px var(--line);
    color: var(--muted); font-weight: 600; font-size: 12px; white-space: nowrap; }
  /* The English column stays put when the table scrolls sideways. */
  tbody td:first-child, thead th:first-child { position: sticky; left: 0; background: var(--raised); }
  tbody td:first-child { box-shadow: inset -1px 0 var(--line); }
  thead th:first-child { z-index: 2; box-shadow: inset -1px 0 var(--line), inset 0 -1px var(--line); }
  tbody tr:hover td { background: color-mix(in srgb, var(--line) 40%, var(--raised)); }
  tbody tr:hover td.missing { background: var(--missing-bg); }
  td.missing { background: var(--missing-bg); }
  td.missing::after { content: "Missing"; color: var(--missing-text); font-size: 12px; font-weight: 600; }
  .empty { margin: 0; padding: 24px; text-align: center; color: var(--muted); }
  @media (max-width: 600px) {
    body { padding: 16px; }
  }
</style>
</head>
<body>
<h1>Translations</h1>
<p class="sub">{{.Total}} source {{if eq .Total 1}}string{{else}}strings{{end}} &middot; {{len .Locales}} {{if eq (len .Locales) 1}}locale{{else}}locales{{end}} &middot; {{.MissingRows}} {{if eq .MissingRows 1}}row needs{{else}}rows need{{end}} translation</p>

<div class="tiles">
{{- range .Locales}}
  <div class="tile {{.Level}}">
    <b>{{.Percent}}%</b>
    <span class="name">{{.Name}}</span>
    <div class="meter" role="img" aria-label="{{.Name}} {{.Percent}}% translated"><i style="width: {{.Percent}}%"></i></div>
    <small>{{.Translated}} of {{.Total}} translated</small>
  </div>
{{- end}}
</div>

<div class="toolbar">
  <input type="search" id="search" placeholder="Search English or translations" aria-label="Search English or translations" autocomplete="off">
  <label><input type="checkbox" id="missing-only"> Missing only</label>
  <span class="count" id="count" aria-live="polite">{{len .Rows}} {{if eq (len .Rows) 1}}row{{else}}rows{{end}}</span>
</div>

<div class="scroll">
<table style="--locales: {{len .Locales}}">
  <thead>
    <tr>
      <th>English</th>
      {{- range .Locales}}
      <th>{{.Name}}</th>
      {{- end}}
    </tr>
  </thead>
  <tbody>
    {{- range .Rows}}
    <tr{{if .Missing}} data-missing{{end}}>
      <td>{{.English}}</td>
      {{- range .Cells}}
      {{- if .Missing}}
      <td class="missing"></td>
      {{- else}}
      <td>{{.Text}}</td>
      {{- end}}
      {{- end}}
    </tr>
    {{- end}}
  </tbody>
</table>
<p class="empty" id="empty"{{if .Rows}} hidden{{end}}>{{if .Rows}}No rows match.{{else}}Every locale matches English.{{end}}</p>
</div>

<script>
  (function () {
    var search = document.getElementById("search");
    var missingOnly = document.getElementById("missing-only");
    var count = document.getElementById("count");
    var empty = document.getElementById("empty");
    var rows = Array.prototype.slice.call(document.querySelectorAll("tbody tr"));
    if (rows.length === 0) return;
    // Lowercase each row's text once, not on every keystroke.
    var haystacks = rows.map(function (row) { return row.textContent.toLowerCase(); });
    function rowsLabel(n) { return n + (n === 1 ? " row" : " rows"); }
    function apply() {
      var term = search.value.trim().toLowerCase();
      var shown = 0;
      rows.forEach(function (row, index) {
        var match = (!missingOnly.checked || row.hasAttribute("data-missing")) &&
          (term === "" || haystacks[index].indexOf(term) !== -1);
        if (row.hidden === match) row.hidden = !match;
        if (match) shown++;
      });
      count.textContent = shown === rows.length ? rowsLabel(rows.length) : shown + " of " + rowsLabel(rows.length);
      empty.hidden = shown !== 0;
    }
    search.addEventListener("input", apply);
    missingOnly.addEventListener("change", apply);
  })();
</script>
</body>
</html>
