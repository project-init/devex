<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Translations</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.classless.min.css" />
    <style>
      thead th {
        position: sticky;
        top: 0;
        background: var(--pico-background-color);
      }
      tbody tr:hover td {
        background: var(--pico-code-background-color);
      }
    </style>
  </head>
  <body>
    <header>
      <h1>Translations</h1>
      <p>{{len .Rows}} strings &middot; {{len .Locales}} {{if eq (len .Locales) 1}}locale{{else}}locales{{end}}</p>
    </header>
    <main>
      <table>
        <thead>
          <tr>
            <th>English</th>
            {{- range .Locales}}
            <th>{{.}}</th>
            {{- end}}
          </tr>
        </thead>
        <tbody>
          {{- range .Rows}}
          <tr>
            <td>{{.English}}</td>
            {{- range .Translations}}
            <td>{{.}}</td>
            {{- end}}
          </tr>
          {{- end}}
        </tbody>
      </table>
    </main>
  </body>
</html>
